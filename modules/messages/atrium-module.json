{
	"schema": 1,
	"id": "messages",
	"name": "Nachrichten",
	"description": "E-Mails an Mitglieder und Gruppen mit Editor, Anhängen und wählbarem Absender; Posteingang für Antworten (Catch-all per IMAP)",
	"version": "1.7.0",
	"core": ">=2.0.0-0 <3.0.0",
	"dependencies": {
		"members": {
			"version": "^1.14.0"
		}
	},
	"optionalDependencies": {
		"offices": {
			"version": "^1.2.0"
		}
	},
	"permissions": [
		"messages.ai.use",
		"messages.inbox.manage",
		"messages.inbox.stamm",
		"messages.mailbox.manage",
		"messages.message.send",
		"messages.message.view-all",
		"messages.settings.manage",
		"messages.website.contact"
	],
	"npm": {
		"imapflow": "2.2.10",
		"mailparser": "3.9.36"
	}
}
