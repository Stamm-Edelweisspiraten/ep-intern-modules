	"version": "1.3.0",
	"core": ">=2.0.0-0 <3.0.0",
	"dependencies": {},
	"optionalDependencies": {
		"members": {
			"version": "^1.14.0"
		},
		"actions": {
			"version": "^1.9.0"
		}
	},
	"permissions": [
		"notes.ai.use",
		"notes.link.create",
		"notes.note.create",
		"notes.note.edit-all",
		"notes.note.view",
		"notes.note.view-all"
	],
	"npm": {
		"yjs": "13.6.33",
		"y-protocols": "1.0.7",
		"docx": "9.15.0",
		"@tiptap/extension-collaboration": "3.32.0",
		"@tiptap/extension-collaboration-caret": "3.32.0",
		"@tiptap/y-tiptap": "3.0.11",
		"@tiptap/markdown": "3.32.0"
	}
}
