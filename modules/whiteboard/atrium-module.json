			"version": "^1.14.0"
		},
		"actions": {
			"version": "^1.9.0"
		},
		"tasks": {
			"version": "^1.2.0"
		},
		"events": {
			"version": "^1.4.0"
		},
		"galleries": {
			"version": "^1.3.0"
		},
		"files": {
			"version": "^1.3.0"
		},
		"notes": {
			"version": "^1.3.0"
		}
	},
	"permissions": [
		"whiteboard.board.create",
		"whiteboard.board.edit-all",
		"whiteboard.board.view",
